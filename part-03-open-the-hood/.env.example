# OnePercent FastAPI course — Part 03 environment config.
#
# Copy this file to .env and add a real key:   cp .env.example .env
# .env is gitignored — NEVER commit it. This .example file (no real secrets) is safe to commit.

APP_NAME=OnePercent Rates API
DEBUG=true

# External exchange-rate API — used by GET /rates/live.
# Get a free key ("App ID") at https://openexchangerates.org
RATE_API_URL=https://openexchangerates.org
RATE_API_KEY=your_openexchangerates_app_id_here

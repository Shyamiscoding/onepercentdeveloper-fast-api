# OnePercent FastAPI course — Part 05 environment config.
#
# Easiest: reuse Part 03's .env (it already has your key):  cp ../part-03-open-the-hood/.env .env
# Or copy this file:                                         cp .env.example .env
# .env is gitignored — NEVER commit it. This .example file (no real secrets) is safe to commit.

# ── from Part 03 ──
APP_NAME=OnePercent Rates API
DEBUG=false

# The live exchange-rate API (free key / "App ID": https://openexchangerates.org)
RATE_API_URL=https://openexchangerates.org
RATE_API_KEY=your_openexchangerates_app_id_here

# ── new in Part 05 ──
# The shared key that guards /admin/rates and POST /rates/sync (send it as the x-api-key header).
# Part 07 replaces it with a real admin login.
ADMIN_API_KEY=secret
